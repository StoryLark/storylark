{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__BRAND_ID__",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // Everything runs through the Worker. Documents get this deployment's live
    // origins / VAPID key (storylark-worker/lib/deployment), brand and
    // presentation stamped in; the manifest is generated from the live
    // brand.json; /icons/* can come from an installed theme package
    // (storylark-worker/lib/theme-store); and /assets/* can come from an
    // installed ENGINE (storylark-worker/lib/engine-store) — which is what
    // makes the portal's "Update now" work with no stored credential. With
    // nothing installed the Worker falls straight through to the asset router,
    // paying one in-memory check per asset request.
    "run_worker_first": ["/*"],
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true },
  "env": {
    "__BRAND_ID__": {
      "name": "__BRAND_ID__",
      "routes": [{ "pattern": "app.example.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "__BRAND_ID__",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "node_modules/storylark-worker/migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "CONTENT", "bucket_name": "__BRAND_ID__-content" }
      ],
      "vars": {
        "BRAND": "__BRAND_ID__",
        "APP_ORIGIN": "https://app.example.com",
        // "" = same-origin (the default): the Worker serves content from the
        // CONTENT bucket itself at /manifest.json and /books/* — no R2 custom
        // domain, no DNS setup. Set a URL (e.g. "https://content.example.com")
        // only to serve content from its own domain; that requires attaching
        // an R2 custom domain to the bucket.
        "CONTENT_ORIGIN": "",
        "MAIL_FROM": "__APP_NAME__ <noreply@example.com>",
        "APP_NAME": "__APP_NAME__"
      }
    }
  }
}
