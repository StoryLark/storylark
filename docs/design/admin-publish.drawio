<mxfile host="app.diagrams.net">
  <diagram name="Admin Publish" id="storylark-admin-publish">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="460" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="b1" value="Operator fills form&#10;/admin — Publish a story" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="POST /api/admin/publish-story&#10;(admin session gated)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="220" height="60" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="Commit content/books/&lt;id&gt;.md&#10;via GitHub Contents API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="580" y="40" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="Dispatch publish.yml&#10;(workflow_dispatch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="860" y="40" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p1" value="1. Parse&#10;(markdown-import.mjs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="2. Diff by&#10;content hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="220" y="200" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="3. Narrate&#10;(if TTS configured)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="400" y="200" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="4. Force-align" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="580" y="200" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="5. Upload&#10;(R2 / Azure Blob)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="760" y="200" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="6. Manifest, last" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="940" y="200" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="7. Push notify&#10;subscribed readers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="940" y="300" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="r1" value="Response is honest:&#10;committed=true/false, published=true/false&#10;— never claims narration/publish it hasn't observed" style="text;html=1;fontSize=12;align=center;fontStyle=2;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="1020" height="40" as="geometry" />
        </mxCell>

        <mxCell id="be1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="be3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="link1" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;exitX=0.5;exitY=1;entryX=0.1;entryY=0;" edge="1" parent="1" source="b4" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="p3" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe5" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="pe6" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
