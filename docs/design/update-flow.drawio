<mxfile host="app.diagrams.net">
  <diagram name="Self-Update" id="storylark-update-flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="d1" value="Daily check&#10;(Cron Trigger / setInterval)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="npm registry&#10;(storylark-worker latest)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="280" y="40" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="New version found?&#10;Email ADMIN_EMAIL&#10;(if configured)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="520" y="40" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="Operator opens /admin&#10;(or reads the email)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="Clicks Install update&#10;&#10;THE CLICK = THE APPROVAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="180" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="POST /api/admin/update-install&#10;(admin-key gated)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="540" y="180" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="GitHub Actions&#10;workflow_dispatch&#10;(self-update.yml)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="800" y="180" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="w1" value="1. Bump pinned&#10;engine version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="2. Snapshot DB&#10;(Postgres path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="220" y="330" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w3" value="3. Apply&#10;migrations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="400" y="330" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w4" value="4. Build&#10;(brand untouched)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="580" y="330" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w5" value="5. Redeploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="760" y="330" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="brand" value="brands/&lt;id&gt;/ — never written by any step above" style="text;html=1;fontSize=12;align=center;fontStyle=2;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="860" height="30" as="geometry" />
        </mxCell>

        <mxCell id="de1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="we1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="w1" target="w2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="we2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="w2" target="w3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="we3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="w3" target="w4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="we4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="w4" target="w5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="link1" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;exitX=0.5;exitY=1;entryX=0.1;entryY=0;" edge="1" parent="1" source="a4" target="w1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
