<mxfile host="app.diagrams.net">
  <diagram name="Update-Flow" id="storylark-update-flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="l1" value="LAYER 1 — DETECT (runs in the deployment, zero credentials)" style="text;html=1;fontSize=12;align=left;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="600" height="20" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="Daily check&#10;(Cron Trigger / setInterval)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="npm registry&#10;(storylark-worker latest)&#10;unauthenticated, read-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="280" y="40" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="New version found?&#10;Email ADMIN_EMAIL&#10;(if configured)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="520" y="40" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="GET /api/admin/update-status&#10;(admin session gated)&#10;same check, on demand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="760" y="40" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="Operator opens /admin&#10;(or reads the email)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="Platform update card:&#10;current vs latest&#10;+ updateCommand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="150" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="NO INSTALL BUTTON&#10;the deployment holds no&#10;credential that can deploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="150" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="l2" value="LAYER 2 — UPDATE (runs on the operator's own machine — the only path that ships anything)" style="text;html=1;fontSize=12;align=left;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="800" height="20" as="geometry" />
        </mxCell>

        <mxCell id="u0" value="node platforms/&lt;platform&gt;/install.mjs --update --yes&#10;&#10;THE COMMAND = THE APPROVAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cred" value="Authenticates with the operator's existing&#10;wrangler login / az login. Nothing new is&#10;stored in the deployment. No GitHub anywhere." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="440" y="280" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="u1" value="1. Bump pinned&#10;engine version&#10;(--save-exact)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="u2" value="2. npm install&#10;THEN migrate&#10;(never the reverse)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="250" y="400" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="u3" value="3. Build&#10;(brand untouched)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="400" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="u4" value="4. Redeploy&#10;wrangler deploy /&#10;az webapp deploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="670" y="400" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="u5" value="5. Print old -&gt; new&#10;engine version" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="880" y="400" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="shared" value="Steps 2-5 are the same function --deploy calls — one code path, so the two can never drift.&#10;What --update does NOT do: provision infrastructure, edit wrangler.jsonc, or write any secret." style="text;html=1;fontSize=12;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="1020" height="40" as="geometry" />
        </mxCell>
        <mxCell id="brand" value="brands/&lt;id&gt;/ — never written by any step above" style="text;html=1;fontSize=12;align=center;fontStyle=2;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="1020" height="30" as="geometry" />
        </mxCell>
        <mxCell id="future" value="Deferred: a genuine one-click in-portal update, blocked on the prebuilt-release-artifact work&#10;(brand as runtime data). Removed, not deferred: the GitHub Actions workflow_dispatch button." style="text;html=1;fontSize=11;align=center;fontStyle=2;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="1020" height="40" as="geometry" />
        </mxCell>

        <mxCell id="de1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="de3" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="d2" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae2" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="d4" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ae4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="a2" target="u0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ue0" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="cred" target="u0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ue1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="u0" target="u1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ue2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="u1" target="u2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ue3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="u2" target="u3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ue4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="u3" target="u4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ue5" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="u4" target="u5"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
