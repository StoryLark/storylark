<mxfile host="app.diagrams.net">
  <diagram name="StoryLark Infrastructure" id="storylark-infra">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title-cf" value="Cloudflare (reference)" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="440" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cf-worker" value="Worker&#10;(storylark-worker, Hono)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="180" y="80" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cf-assets" value="Static assets&#10;(the built PWA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cf-d1" value="D1&#10;(accounts, progress, sessions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cf-r2" value="R2&#10;(published content, public)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="200" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cf-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="cf-worker" target="cf-d1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cf-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="cf-worker" target="cf-r2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="title-az" value="Azure" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="580" y="20" width="440" height="30" as="geometry" />
        </mxCell>
        <mxCell id="az-app" value="App Service&#10;(server.mjs, @hono/node-server,&#10;same storylark-worker app)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="700" y="80" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="az-static" value="Static assets&#10;(served by the same process)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="580" y="80" width="100" height="70" as="geometry" />
        </mxCell>
        <mxCell id="az-pg" value="PostgreSQL Flexible Server&#10;(accounts, progress, sessions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="620" y="220" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="az-blob" value="Blob Storage&#10;(published content, public container)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="840" y="220" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="az-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="az-app" target="az-pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="az-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="az-app" target="az-blob">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="seam-note" value="Same route code both sides — only the driver bound to env.DB / the storage provider differs.&#10;packages/worker/src/db/{d1,postgres}.ts  ·  packages/pipeline/{r2-upload,storage-azure}.mjs" style="text;html=1;fontSize=12;align=center;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="980" height="40" as="geometry" />
        </mxCell>

        <mxCell id="reader" value="Reader's browser / installed PWA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="450" y="420" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.25;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="reader" target="cf-worker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.75;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="reader" target="az-app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
