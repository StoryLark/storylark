{
  // StoryLark — one Worker per brand, selected with --env.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storylark",
  "main": "packages/worker/src/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "app/dist",
    "binding": "ASSETS",
    // Documents run through the Worker so it can stamp this deployment's live
    // origins / VAPID key (AB#7414 — packages/worker/src/lib/deployment.ts), its
    // live brand (AB#7415 — .../lib/brand.ts) and its live presentation
    // (AB#7416 — .../lib/presentation.ts) into them. The negative rules
    // keep the bulk of the site — hashed JS/CSS/fonts and the icon files — on
    // the asset router, served with no Worker invocation exactly as before;
    // what costs an invocation is a navigation, /admin, /sw.js, /theme.css and
    // the manifest, i.e. a handful per page load rather than one per file.
    // Deep links still resolve here and fall through to the SPA shell via
    // ASSETS.fetch, so not_found_handling below still governs them.
    //
    // manifest.webmanifest lost its exclusion in Phase 2: it is now generated
    // from the live brand on every request, so an operator who swaps
    // brand.json gets an installable app with the new name and colours without
    // rebuilding anything.
    //
    // /icons/* lost its exclusion in Phase 4 (AB#7417): an imported theme
    // package carries its own icons, and they live in the deployment's storage
    // rather than in the immutable asset snapshot, so the Worker has to be the
    // one answering. With no theme installed the handler falls straight through
    // to the asset router's own bytes — the cost is one invocation for the two
    // or three icon requests a cold page load makes, and the alternative is a
    // brand whose pictures can only be changed by rebuilding.
    //
    // /assets/* lost its exclusion with the engine store (AB#7418), for the
    // same reason at a larger scale: an INSTALLED ENGINE's hashed bundle lives
    // in the deployment's storage, so the Worker has to be able to answer it.
    // The tradeoff is real — every asset request now costs a Worker invocation
    // — and it is mitigated where it matters: a deployment with no engine
    // installed (the default) pays one in-memory check per request, not a
    // storage read, via the negative-result cache in the worker's
    // installedEngine(). The alternative is an update path that differs per
    // platform, which is the thing AB#7418 exists to delete.
    "run_worker_first": ["/*"],
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true },
  // One env per brand, selected with `--env`. `storylark` is the base build /
  // default theme (deploys to storylark.dev): copy this block, rename it, and
  // fill in the brand's own domain, D1 database_id, R2 bucket, and vars.
  "env": {
    "storylark": {
      "name": "storylark-demo-prod",
      // Turner Publishing Group. The account is shared, so every resource
      // carries the project and the environment in its name — the account's
      // existing convention, matched rather than replaced.
      "account_id": "513fcac25bb11fbe8c772ab242433445",
      "routes": [{ "pattern": "storylark.dev", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "storylark-demo-prod",
          "database_id": "f4694934-deec-4351-8ee8-89691d6d3ed6",
          "migrations_dir": "packages/worker/migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "CONTENT", "bucket_name": "storylark-demo-content-prod" }
      ],
      "vars": {
        "BRAND": "storylark",
        "APP_ORIGIN": "https://storylark.dev",
        "CONTENT_ORIGIN": "",
        "MAIL_FROM": "StoryLark <noreply@storylark.dev>",
        "APP_NAME": "StoryLark"
      },
      // Daily operator-update check (AB#7403/F2) — set ADMIN_EMAIL +
      // RESEND_API_KEY (wrangler secret put) to also email when a new
      // release is found; the in-portal check works either way.
      "triggers": { "crons": ["0 13 * * *"] }
    }
  }
}
