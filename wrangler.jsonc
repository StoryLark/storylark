{
  // StoryLark — one Worker per brand, selected with --env.
  // Static assets are served free of Worker invocations; only /api/* runs code.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storylark",
  "main": "packages/worker/src/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "app/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true },
  // One env per brand, selected with `--env`. `storylark` is the base build /
  // default theme (deploys to storylark.dev): copy this block, rename it, and
  // fill in the brand's own domain, D1 database_id, R2 bucket, and vars.
  "env": {
    "storylark": {
      "name": "storylark",
      "routes": [{ "pattern": "app.storylark.dev", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "storylark",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "packages/worker/migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "CONTENT", "bucket_name": "storylark-content" }
      ],
      "vars": {
        "BRAND": "storylark",
        "APP_ORIGIN": "https://app.storylark.dev",
        "CONTENT_ORIGIN": "https://content.storylark.dev",
        "MAIL_FROM": "StoryLark <noreply@storylark.dev>",
        "APP_NAME": "StoryLark"
      },
      // Daily operator-update check (AB#7403/F2) — set ADMIN_EMAIL +
      // RESEND_API_KEY (wrangler secret put) to also email when a new
      // release is found; the in-portal check works either way.
      "triggers": { "crons": ["0 13 * * *"] }
    },
    // Example customer brands — placeholder IDs/domains on purpose; a real
    // deployment fills in its own resources (see docs/deploy-your-own.md).
    "gunner-the-lab": {
      "name": "gunner-the-lab",
      "routes": [{ "pattern": "app.example.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gunner-the-lab",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "packages/worker/migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "CONTENT", "bucket_name": "gunner-the-lab-content" }
      ],
      "vars": {
        "BRAND": "gunner-the-lab",
        "APP_ORIGIN": "https://app.example.com",
        "CONTENT_ORIGIN": "https://content.example.com",
        "MAIL_FROM": "Gunner the Lab <noreply@example.com>",
        "APP_NAME": "StoryReader"
      },
      "triggers": { "crons": ["0 13 * * *"] }
    },
    "hold-fast-press": {
      "name": "hold-fast-press",
      "routes": [{ "pattern": "app.example.com", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hold-fast-press",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "packages/worker/migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "CONTENT", "bucket_name": "hold-fast-press-content" }
      ],
      "vars": {
        "BRAND": "hold-fast-press",
        "APP_ORIGIN": "https://app.example.com",
        "CONTENT_ORIGIN": "https://content.example.com",
        "MAIL_FROM": "Holdfast Press <noreply@example.com>",
        "APP_NAME": "StoryReader"
      },
      "triggers": { "crons": ["0 13 * * *"] }
    }
  }
}
