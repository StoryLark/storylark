# Copy to install.env and fill in. This drives `node install.mjs`.
# Not the same as .env.example (the running app's config) — this one is
# only for provisioning the infrastructure via infra.bicep.

BRAND_ID=your-brand-id
AZURE_RESOURCE_GROUP=rg-storylark-your-brand
AZURE_LOCATION=eastus
DB_ADMIN_PASSWORD=
