# Copy to install.env and fill in. This drives `node install.mjs`.
# Not the same as .env.example (the running app's config) — this one is
# only for provisioning the infrastructure via infra.bicep.

BRAND_ID=your-brand-id
AZURE_RESOURCE_GROUP=rg-storylark-your-brand
AZURE_LOCATION=eastus
DB_ADMIN_PASSWORD=

# Optional. Postgres Flexible Server provisioning is restricted to a subset of
# regions per subscription — if a deploy fails with
# `ParameterOutOfRange: 'Version' should be in: []`, AZURE_LOCATION is
# restricted for your subscription even though the SKU/version genuinely
# exists there. Set DB_LOCATION to an unrestricted region to put just the
# database elsewhere while everything else stays in AZURE_LOCATION.
# DB_LOCATION=centralus

# Optional. App Service Plan SKU (default B1). Set to F1 (free tier) if your
# subscription has zero quota for the B-series VM family in AZURE_LOCATION —
# check with: az vm list-usage --location <region>
# APP_SERVICE_SKU=F1

# Optional. Admin portal (/admin) access key — leave unset to keep the admin
# portal disabled. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# ADMIN_KEY=
