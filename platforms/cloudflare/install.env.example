# Copy to install.env and fill in. This drives `node install.mjs`.

BRAND_ID=your-brand-id
APP_ORIGIN=https://app.example.com
MAIL_FROM=Your App <noreply@example.com>
APP_NAME=Your App Name

# Choose the content entry point the deployment should open with:
#   portal — upload Markdown and images in Admin
#   repo   — StoryLark pulls a validated GitHub repository itself
#   api    — a CMS or release system publishes through the content API
CONTENT_SOURCE=portal

# Repository mode only. Public repositories need no token. Private
# repositories require a durable, read-only credential limited to this repo.
# The installer stores it as the Worker's CONTENT_SYNC_TOKEN secret and then
# saves and performs the initial connection through StoryLark's validation gate.
# CONTENT_REPO_URL=https://github.com/owner/content-repo
# CONTENT_REPO_VISIBILITY=private
# CONTENT_REPO_BRANCH=main
# CONTENT_REPO_PATH=
# CONTENT_REPO_INTERVAL_HOURS=24
# CONTENT_REPO_ADOPT_MATCHING=false
# CONTENT_SYNC_TOKEN=

# Optional resource aliases for an existing deployment whose Cloudflare
# environment, Worker, D1 database, or R2 bucket do not match BRAND_ID.
# CLOUDFLARE_ENV=production
# WORKER_NAME=your-existing-worker
# D1_DATABASE=your-existing-database
# R2_BUCKET=your-existing-content-bucket

# Optional. Leave unset (or blank) and content is served SAME-ORIGIN: the
# Worker answers /manifest.json and /books/* straight out of the R2 bucket at
# the app's own domain — no R2 custom domain, no DNS setup. Set it only to
# serve content from a separate domain/CDN (content then bypasses the Worker);
# that requires attaching an R2 custom domain to the content bucket.
# CONTENT_ORIGIN=https://content.example.com

# Optional. Deployment-config credential used to mint the FIRST admin setup
# link and the printed recovery codes (see docs/admin-guide.md). It is NOT
# the admin login — /admin is gated by a normal email+password account. Leave
# this unset and the installer generates one, sets it as a Worker secret, and
# uses it once at the end of the deploy.
# ADMIN_KEY=

# Optional. Self-update for API-server releases is provisioned automatically by
# --deploy/--update (engine releases never need it — they install through the
# site's own storage). Set to "off" to keep that provisioning from ever running;
# --disable-one-click writes this for you.
# SELF_UPDATE=off
