{
  "name": "storylark-pipeline",
  "version": "0.13.0",
  "description": "StoryLark publish pipeline — parse → TTS → stitch → R2/local mirror → manifest → push notify. Site-agnostic: runs from a site repo's root with an injected content parser.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StoryLark/storylark.git",
    "directory": "packages/pipeline"
  },
  "type": "module",
  "bin": {
    "storylark-publish": "publish.mjs",
    "storylark-sync": "sync.mjs",
    "storylark-narrate": "narrate.mjs",
    "storylark-gen-icons": "gen-icons.mjs",
    "storylark-gen-vapid": "gen-vapid.mjs"
  },
  "exports": {
    "./md": "./lib/md.mjs",
    "./tts": "./tts.mjs",
    "./tts-kokoro": "./tts-kokoro.mjs",
    "./align": "./align.mjs",
    "./stitch": "./stitch.mjs",
    "./package.json": "./package.json",
    "./storage": "./storage.mjs"
  },
  "files": [
    "publish.mjs",
    "sync.mjs",
    "narrate.mjs",
    "gen-icons.mjs",
    "gen-vapid.mjs",
    "r2-upload.mjs",
    "storage.mjs",
    "storage-azure.mjs",
    "stitch.mjs",
    "tts.mjs",
    "tts-kokoro.mjs",
    "align.mjs",
    "lib/"
  ],
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "kokoro-js": "^1.2.1",
    "microsoft-cognitiveservices-speech-sdk": "^1.42.0",
    "sharp": "^0.34.5",
    "@azure/storage-blob": "^12.26.0"
  }
}
