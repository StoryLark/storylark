{
  "name": "storylark-worker",
  "version": "0.4.0",
  "description": "StoryLark API Worker — Hono app over D1 + R2 (auth, progress sync, push, admin publish). Import the default export from your site's worker entry; migrations ship in ./migrations.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StoryLark/storylark.git",
    "directory": "packages/worker"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./migrations/*": "./migrations/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "migrations/"
  ],
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.0"
  }
}
