{
  "name": "storylark-worker",
  "version": "0.17.0",
  "description": "StoryLark API Worker — Hono app over D1 + R2 (auth, progress sync, push, admin publish). Import the default export from your site's worker entry; migrations ship in ./migrations.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StoryLark/storylark.git",
    "directory": "packages/worker"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./migrations/*": "./migrations/*",
    "./migrate-postgres.mjs": "./migrate-postgres.mjs",
    "./package.json": "./package.json",
    "./db/postgres": "./src/db/postgres.ts",
    "./db/d1": "./src/db/d1.ts",
    "./db/types": "./src/db/types.ts",
    "./lib/update-check": "./src/lib/update-check.ts",
    "./lib/deployment": "./src/lib/deployment.ts",
    "./lib/brand": "./src/lib/brand.ts",
    "./lib/presentation": "./src/lib/presentation.ts",
    "./lib/theme-store": "./src/lib/theme-store.ts",
    "./lib/self-deploy": "./src/lib/self-deploy.ts",
    "./lib/engine-release": "./src/lib/engine-release.ts"
  },
  "files": [
    "src/",
    "migrations/",
    "migrations-postgres/",
    "migrate-postgres.mjs"
  ],
  "dependencies": {
    "storylark-contracts": "0.4.0",
    "@simplewebauthn/server": "^13.3.2",
    "hono": "^4.6.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.0",
    "@types/pg": "^8.11.0",
    "@electric-sql/pglite": "^0.5.5",
    "@electric-sql/pglite-socket": "^0.2.8"
  }
}
