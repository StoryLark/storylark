node_modules/
dist/
# migrate-brand's safety copy of a pre-split brand.json — local only; git history
# already has the original.
*.pre-split.bak
# Theme packages built by `npm run package-theme` (AB#7417). The DEFAULT one is
# committed on purpose — it is the "Classic Library" artifact the gallery has
# only ever described, and packages/worker/test/theme-package.test.mjs asserts
# it still matches brands/storylark byte for byte. Everything else here is a
# build output of a brand folder that is already in the repo.
themes/*.storylark-theme.zip
!themes/storylark.storylark-theme.zip
dist-themes/
# The prebuilt engine artifact (AB#7418). Built by CI on a release and attached
# to the GitHub Release; never committed — it is 3.5MB of build output whose
# whole purpose is to be downloaded from a release, not from a checkout.
dist-engine/
.engine-worker/

.wrangler/
.dev.vars
*.local
.env
.env.*
.storylark/
*.mp3
!brands/**/*.mp3
.DS_Store
Thumbs.db

# stray literal folder from unexpanded hook variable
{{REPO_ROOT}}/

# Private workspace, agent harness, and internal planning - never in the public repo
.ai/
.claude/
.codex/
.mcp.json
.github/
# ...except the scaffold template's own .github/ — this is shipped content
# (stamped into every npm-create-storylark site), not this repo's own CI.
!create-storylark/template/.github/
!create-storylark/template/.github/**
.wrangler/
/AGENTS.md
/CLAUDE.md
/REPO_INTENT.md
/pmo/
/todo.md
